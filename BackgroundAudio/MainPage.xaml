<Page
    x:Class="BackgroundAudio.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BackgroundAudio"
    xmlns:models="using:BackgroundAudio.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    UseSystemFocusVisuals="True"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    FontSize="32"
                    FontWeight="Bold"
                    Text="Audio Player"/>

        <MediaPlayerElement x:Name="PlayerElement"
                           Visibility="Collapsed"/>

        <ScrollViewer Grid.Row="1" HorizontalContentAlignment="Center">
            <StackPanel HorizontalAlignment="Center" Spacing="16">
                <Border x:Name="AlbumArtBorder"
                        Width="300"
                        Height="300"
                        HorizontalAlignment="Center"
                        Background="#33000000"
                        CornerRadius="8">
                    <Image x:Name="AlbumArt"
                           Stretch="UniformToFill"/>
                </Border>

                <TextBlock x:Name="TrackTitle"
                          TextAlignment="Center"
                          FontSize="28"
                          FontWeight="Bold"
                          Text="Kein Track"/>

                <TextBlock x:Name="TrackArtist"
                          TextAlignment="Center"
                          FontSize="20"
                          Foreground="Gray"
                          Text="-"/>

                <Grid HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTimeText"
                              Grid.Column="0"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              FontSize="16"
                              Text="0:00"/>
                    <Slider x:Name="ProgressSlider"
                           Grid.Column="1"
                           MinWidth="500"
                           Minimum="0"
                           Maximum="100"
                           IsThumbStickEnabled="True"
                           ManipulationMode="All"
                           ManipulationStarted="ProgressSlider_ManipulationStarted"
                           ManipulationCompleted="ProgressSlider_ManipulationCompleted"
                           ValueChanged="ProgressSlider_ValueChanged"/>
                    <TextBlock x:Name="TotalTimeText"
                              Grid.Column="2"
                              VerticalAlignment="Center"
                              Margin="12,0,0,0"
                              FontSize="16"
                              Text="0:00"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="16"
                    Margin="0,12,0,0">
            <Button x:Name="PreviousButton"
                   Content="⏮"
                   FontSize="24"
                   MinHeight="48"
                   MinWidth="48"
                   Click="PreviousButton_Click"
                   XYFocusRight="PlayButton"/>
            <Button x:Name="PlayButton"
                   Content="▶"
                   FontSize="32"
                   MinHeight="48"
                   MinWidth="80"
                   Click="PlayButton_Click"
                   XYFocusLeft="PreviousButton"
                   XYFocusRight="NextButton"/>
            <Button x:Name="NextButton"
                   Content="⏭"
                   FontSize="32"
                   MinHeight="48"
                   MinWidth="48"
                   Click="NextButton_Click"
                   XYFocusLeft="PlayButton"
                   XYFocusRight="ShuffleButton"/>
            <Button x:Name="ShuffleButton"
                   Content="🔀"
                   FontSize="24"
                   MinHeight="48"
                   MinWidth="48"
                   Click="ShuffleButton_Click"
                   XYFocusLeft="NextButton"/>
        </StackPanel>

        <ScrollViewer Grid.Row="3" MaxHeight="200" Margin="0,12,0,0">
            <ListView x:Name="PlaylistView"
                     SelectionMode="Single"
                     IsItemClickEnabled="True"
                     ItemClick="PlaylistView_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <StackPanel Spacing="4" Padding="0,4">
                            <TextBlock Text="{x:Bind Title}"
                                      FontSize="18"
                                      FontWeight="Bold"/>
                            <TextBlock Text="{x:Bind Artist}"
                                      FontSize="14"
                                      Foreground="Gray"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>
    </Grid>
</Page>
